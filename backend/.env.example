# LLM Provider: 'omniroute' (default), 'gemini', 'anthropic', 'ollama', or 'offline'
LLM_PROVIDER=

# OmniRoute Gateway Configuration
OMNIROUTE_BASE_URL=
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=

# Direct Provider Keys (optional fallbacks)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Ollama Local AI Configuration (optional)
OLLAMA_HOST=
OLLAMA_MODEL=
OLLAMA_TIMEOUT=

# Execution & Demo Mode (true = offline deterministic demo mode, false = live LLM mode)
DEMO_MODE=

# Server Configuration
PORT=
HOST=
CORS_ORIGINS=
CORS_ORIGIN_REGEX=

# Optional Deployment Integrations
GITHUB_TOKEN=
